    .markdown-body a {
        color: #00a3ff;
        text-decoration: none;
        font-weight: bold;
    }

        .markdown-body a:hover {
            text-decoration: underline;
        }

    .markdown-body ul {
        padding-left: 20px;
        margin: 10px 0;
    }
