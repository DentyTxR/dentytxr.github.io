@page "/callback"
@using System.Net.Http.Headers
@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager NavManager
@inject IJSRuntime JSRuntime
@inject HttpClient Http

<h3>Processing Discord Login...</h3>
<p>@statusMessage</p>

@code {
    private string statusMessage = "Exchanging code for token...";

    protected override async Task OnInitializedAsync()
    {
        var uri = NavManager.ToAbsoluteUri(NavManager.Uri);

        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("code", out var codes))
        {
            var code = codes.First();

            var verifier = await JSRuntime.InvokeAsync<string>("sessionStorage.getItem", "discord_code_verifier");

            if (string.IsNullOrEmpty(verifier))
            {
                statusMessage = "Error: Authentication session lost.";
                return;
            }

            var redirectUri = NavManager.BaseUri + "callback";

            var requestContent = new FormUrlEncodedContent(new[]
            {
                new KeyValuePair<string, string>("client_id", "1541279443740262483"),
                new KeyValuePair<string, string>("grant_type", "authorization_code"),
                new KeyValuePair<string, string>("code", code),
                new KeyValuePair<string, string>("redirect_uri", redirectUri),
                new KeyValuePair<string, string>("code_verifier", verifier)
            });

            var response = await Http.PostAsync("https://discord.com/api/oauth2/token", requestContent);

            if (response.IsSuccessStatusCode)
            {
                var jsonResult = await response.Content.ReadAsStringAsync();

                await JSRuntime.InvokeVoidAsync("localStorage.setItem", "discord_auth_data", jsonResult);

                NavManager.NavigateTo("/");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                statusMessage = $"Failed to get token: {error}";
            }
        }
        else
        {
            statusMessage = "No authorization code found in URL.";
        }
    }
}