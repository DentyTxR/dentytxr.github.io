@inject ISnackbar SnackbarService
@inject IJSRuntime _jsRuntime
@inject NavigationManager NavigationManager
@inject AppUpdateService UpdateService

@code {
    private DotNetObjectReference<UpdateAvailableDetector>? _objRef;

    protected override async Task OnInitializedAsync()
    {
        await RegisterForUpdateAvailableNotification();
    }

    private async Task RegisterForUpdateAvailableNotification()
    {
        // Save the reference so blazors garbage collector doesnt destroy it
        _objRef = DotNetObjectReference.Create(this);

        await _jsRuntime.InvokeAsync<object>(
                    identifier: "registerForUpdateAvailableNotification",
                    _objRef,
                    nameof(OnUpdateAvailable));
    }

    [JSInvokable(nameof(OnUpdateAvailable))]
    public Task OnUpdateAvailable(string Version, string Changelog)
    {
        Console.WriteLine($"Update available! Version: {Version} Changelog: {Changelog}");

        UpdateService.NotifyUpdate(Version, Changelog);

        SnackbarService.Add(@<span>A new version of the app is available.<br /> <b>Version:</b> @Version<br /><b>Update:</b> @Changelog</span>, Severity.Info,
    configure: options =>
    {
        options.RequireInteraction = true;
        options.ShowCloseIcon = true;
        options.Action = "Update";
        options.ActionColor = Color.Info;
        options.SnackbarVariant = Variant.Outlined;
        options.OnClick = snackbar =>
        {
            ReloadPage();
            return Task.CompletedTask;
        };
    });

        return Task.CompletedTask;
    }

    private void ReloadPage()
    {
        NavigationManager.NavigateTo(NavigationManager.Uri, true);
    }

    public void Dispose()
    {
        _objRef?.Dispose();
    }
}