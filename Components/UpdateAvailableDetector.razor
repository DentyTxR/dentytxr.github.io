@inject ISnackbar SnackbarService
@inject IJSRuntime _jsRuntime
@inject NavigationManager NavigationManager
@inject AppUpdateService UpdateService

@code {
    private DotNetObjectReference<UpdateAvailableDetector>? _objRef;

    protected override async Task OnInitializedAsync()
    {
        await RegisterForUpdateAvailableNotification();
    }

    private async Task RegisterForUpdateAvailableNotification()
    {
        // Save the reference so blazors garbage collector doesnt destroy it
        _objRef = DotNetObjectReference.Create(this);

        await _jsRuntime.InvokeAsync<object>(
                    identifier: "registerForUpdateAvailableNotification",
                    _objRef,
                    nameof(OnUpdateAvailable),
                    nameof(OnBuildChange));
    }

    [JSInvokable(nameof(OnUpdateAvailable))]
    public Task OnUpdateAvailable(string Version, string Changelog)
    {
        Console.WriteLine($"Update available! Version: {Version} Changelog: {Changelog}");

        //UpdateService.NotifyUpdate(Version, Changelog);
        SnackbarService.Add(
            @<span><MudText Typo="Typo.subtitle1">A new version of the app is available.</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary"><b>Version:</b> @Version</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary"><b>Update:</b> @Changelog</MudText>
            </span>,
            Severity.Info,
    configure: options =>
    {
        options.RequireInteraction = true;
        options.ShowCloseIcon = true;
        options.Action = "Update";
        options.ActionColor = Color.Info;
        options.SnackbarVariant = Variant.Outlined;
        options.Icon = Icons.Material.Filled.SystemUpdateAlt;
        options.OnClick = snackbar =>
        {
            ReloadPage();
            return Task.CompletedTask;
        };
    });


        return Task.CompletedTask;
    }

    [JSInvokable(nameof(OnBuildChange))]
    public Task OnBuildChange(string build)
    {
        Console.WriteLine($"Build ppdate available! Build Version: {build}");

        // UpdateService.NotifyUpdate();

        SnackbarService.Add(
            @<span><MudText Typo="Typo.subtitle1">A build update has been released.</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary" ">Usually a bugfix, hotfix or rebuild.</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary"><b>Build:</b> @build</MudText>
            </span>,
            Severity.Info,
    configure: options =>
    {
        options.RequireInteraction = true;
        options.ShowCloseIcon = true;
        options.Action = "Update";
        options.ActionColor = Color.Info;
        options.SnackbarVariant = Variant.Outlined;
        options.Icon = Icons.Material.Filled.SystemUpdateAlt;
        options.OnClick = snackbar =>
        {
            ReloadPage();
            return Task.CompletedTask;
        };
    });

        return Task.CompletedTask;
    }

    private void ReloadPage()
    {
        NavigationManager.NavigateTo(NavigationManager.Uri, true);
    }

    public void Dispose()
    {
        _objRef?.Dispose();
    }
}