<MudText id="@(LatestUpdate ? "LatestUpdate" : null)" Typo="Typo.h4">@(LatestUpdate ? $"Latest ({Title})" : Title)</MudText>
<br />

@if (LatestUpdate)
{

    if (Changes.Any())
    {
        <MudText Typo="Typo.h6"><b>New</b></MudText>
        @foreach (var item in New)
        {
            <MudText Typo="Typo.body1">• @item</MudText>
        }
    }

    if (Changes.Any())
    {
        <MudText Typo="Typo.h6" Class="mt-2"><b>Changes</b></MudText>
        @foreach (var item in Changes)
        {
            <MudText Typo="Typo.body1">• @item</MudText>
        }
    }

    if (Issues.Any())
    {
        <MudText Typo="Typo.h6" Class="mt-2"><b>Known Issues</b></MudText>
        @foreach (var item in Issues)
        {
            <MudText Typo="Typo.body1">• @item</MudText>
        }
    }
}
else
{
    <MudExpansionPanels MultiExpansion="true">
        @if (New.Any())
        {
            <MudExpansionPanel>
                <TitleContent>
                    <MudText Typo="Typo.h6">New</MudText>
                </TitleContent>
                <ChildContent>
                    @foreach (var item in New)
                    {
                        <MudText Typo="Typo.body1">• @item</MudText>
                    }
                </ChildContent>
            </MudExpansionPanel>
        }
        @if (Changes.Any())
        {
            <MudExpansionPanel>
                <TitleContent>
                    <MudText Typo="Typo.h6">Changes</MudText>
                </TitleContent>
                <ChildContent>
                    @foreach (var item in Changes)
                    {
                        <MudText Typo="Typo.body1">• @item</MudText>
                    }
                </ChildContent>
            </MudExpansionPanel>
        }
        @if (Issues.Any())
        {
            <MudExpansionPanel>
                <TitleContent>
                    <MudText Typo="Typo.h6">Known Issues</MudText>
                </TitleContent>
                <ChildContent>
                    @foreach (var item in Issues)
                    {
                        <MudText Typo="Typo.body1">• @item</MudText>
                    }
                </ChildContent>
            </MudExpansionPanel>
        }
    </MudExpansionPanels>
}
<br />

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public List<string> New { get; set; } = new();
    [Parameter, EditorRequired] public List<string> Changes { get; set; } = new();
    [Parameter] public List<string> Issues { get; set; } = new();
    [Parameter, EditorRequired] public bool LatestUpdate { get; set; } = true;
}